# Screenshot to Code .env Example
# Copy this file to backend/.env and fill in your actual keys
# This file is NEVER committed to version control

## LLM API Keys (at least one required)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## Custom base URLs (optional)
# For domestic models like Volcano Engine/Doubao, DashScope/GLM, etc.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com

## Image generation (optional)
REPLICATE_API_KEY=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## Volcano Engine (Doubao) API (domestic model)
# VOLCANO_ACCESS_KEY=xxxxxx
# VOLCANO_SECRET_KEY=xxxxxx
# VOLCANO_REGION=cn-beijing
# VOLCANO_MODEL_ENDPOINT_ID=xxxxx

## DashScope (Aliyun/GLM) API (domestic model)
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

## Development settings
IS_DEBUG_ENABLED=False
# Debug output directory (optional)
DEBUG_DIR=./debug_logs
# Enable detailed prompt reports
PROMPT_REPORTS_ENABLED=False
